# ==========================================================================
# estore-backend environment configuration
# Copy to .env and populate. NEVER commit the real .env (it is gitignored).
# ==========================================================================

# --- Core Django ---
SECRET_KEY=                      # REQUIRED. Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=False                      # Keep False in production
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_BASE_URL=https://estore-frontend-boqb.vercel.app

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=

# --- Cache / rate limiting / payment-ref store (REQUIRED in production) ---
# Without REDIS_URL the app falls back to per-process LocMemCache, which makes
# rate limiting ineffective and Paystack ref lookups unreliable across workers.
REDIS_URL=

# --- JWT ---
JWT_SECRET_KEY=                  # Defaults to SECRET_KEY if unset

# --- Paystack ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=http://localhost:3000/orders/callback
PAYMENT_SUCCESS_URL=http://localhost:3000/orders/success
PAYMENT_CANCEL_URL=http://localhost:3000/orders/cancel

# --- Cloudinary (media storage) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Terminal Africa (shipping) ---
TERMINAL_AFRICA_API_KEY=
TERMINAL_AFRICA_BASE_URL=https://api.terminal.africa/v1
TERMINAL_AFRICA_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. no-reply@yourdomain.com
SENDER_EMAIL=
DEFAULT_FROM_NAME=
SITE_NAME=API Service
DISABLE_EMAIL_VERIFICATION=False

# --- Store / shipping origin (POS) ---
STORE_ADDRESS_EMAIL=store@example.com
STORE_ADDRESS_PHONE=+233000000000

# --- Zernio (social media posting) ---
ZERNIO_API_KEY=
ZERNIO_BASE_URL=https://zernio.com/api/v1
# Optional comma-separated platform filter, e.g. instagram,twitter. Empty = all connected accounts.
ZERNIO_PLATFORMS=
# Public storefront base URL used in social post captions
STOREFRONT_BASE_URL=http://localhost:3000
