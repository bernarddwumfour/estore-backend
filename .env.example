# ==========================================================================
# estore-backend environment configuration
# Copy to .env and populate. NEVER commit the real .env (it is gitignored).
# ==========================================================================

# --- Core Django ---
SECRET_KEY=replace-with-a-random-django-secret
DEBUG=False                      # Keep False in production
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_BASE_URL=https://estore-frontend-boqb.vercel.app
# One server-only secret shared by blog and category callbacks for this store.
REVALIDATE_SECRET=
DOMAIN_NAME=localhost:8000       # API domain for link generation
USE_HTTPS=False                  # Set True when serving over HTTPS

# --- Database (Neon PostgreSQL) ---
DATABASE_URL=
# Set False for local sqlite test runs (sqlite rejects sslmode)
DB_SSL_REQUIRE=True

# --- Cache / rate limiting / payment-ref store (REQUIRED in production) ---
# Without REDIS_URL the app falls back to per-process LocMemCache, which makes
# rate limiting ineffective and Paystack ref lookups unreliable across workers.
REDIS_URL=

# --- JWT ---
JWT_SECRET_KEY=replace-with-a-separate-jwt-signing-secret
JWT_ISSUER=estore-backend        # JWT iss claim
JWT_AUDIENCE=estore-clients      # JWT aud claim

# --- Paystack ---
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=http://localhost:3000/orders/callback
PAYMENT_SUCCESS_URL=http://localhost:3000/orders/success
PAYMENT_CANCEL_URL=http://localhost:3000/orders/cancel

# --- Media storage: cloudinary (default), s3, or local ---
MEDIA_STORAGE_BACKEND=cloudinary
# For local storage, use the public API origin so a separate frontend can load uploads.
# MEDIA_URL=http://localhost:8000/media/

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# S3-compatible storage (AWS S3, Neon Object Storage, etc.)
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY can be omitted when using an EC2 IAM role.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_S3_REGION_NAME=
AWS_S3_SIGNATURE_VERSION=s3v4
# Leave blank for AWS S3; set the provider endpoint for S3-compatible storage.
AWS_S3_ENDPOINT_URL=
AWS_S3_ADDRESSING_STYLE=auto
# Optional CDN domain without scheme, e.g. cdn.example.com.
AWS_S3_CUSTOM_DOMAIN=
# Private buckets use expiring signed URLs; public-read buckets may set this False.
AWS_QUERYSTRING_AUTH=True
AWS_QUERYSTRING_EXPIRE=3600

# --- Terminal Africa (shipping) ---
TERMINAL_AFRICA_API_KEY=
TERMINAL_AFRICA_BASE_URL=https://api.terminal.africa/v1
TERMINAL_AFRICA_WEBHOOK_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. no-reply@yourdomain.com
SENDER_EMAIL=
DEFAULT_FROM_NAME=
SITE_NAME=API Service
DISABLE_EMAIL_VERIFICATION=False

# --- Store / shipping origin (POS) ---
STORE_ADDRESS_EMAIL=store@example.com
STORE_ADDRESS_PHONE=+233000000000
STORE_ADDRESS_FIRST_NAME=Store
STORE_ADDRESS_LAST_NAME=Pickup
STORE_ADDRESS_LINE1=123 Main Street
STORE_ADDRESS_LINE2=
STORE_ADDRESS_CITY=Accra
STORE_ADDRESS_STATE=Greater Accra
STORE_ADDRESS_POSTAL_CODE=GA-123
STORE_ADDRESS_COUNTRY=GH
STORE_ADDRESS_INSTRUCTIONS=In-Store Pickup

# --- Affiliate program ---
AFFILIATE_CODE_DISCOUNT_TYPE=percentage     # "percentage" or "fixed"
AFFILIATE_CODE_DISCOUNT_VALUE=5.00
AFFILIATE_COMMISSION_BASE=discounted_subtotal  # "discounted_subtotal" or "original_subtotal"

# --- Zernio (social media posting) ---
ZERNIO_API_KEY=
ZERNIO_WEBHOOK_SECRET=
ZERNIO_BASE_URL=https://zernio.com/api/v1
# Optional comma-separated platform filter, e.g. instagram,twitter. Empty = all connected accounts.
ZERNIO_PLATFORMS=
# Public storefront base URL used in social captions and cache invalidation callbacks
STOREFRONT_BASE_URL=http://localhost:3000



OPENAI_API_KEY=
SHOPPER_ASSISTANT_MODEL=gpt-4.1-mini

AI_EMBEDDING_MODEL=text-embedding-3-small
AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_CACHE_TTL=86400
AI_SEMANTIC_MIN_SIMILARITY=0.25
AI_SEMANTIC_SCORE_MARGIN=0.10

# Server-to-server Next.js BFF authentication; same random secret on both servers.
BFF_SHARED_SECRET=
